    "That isn't a PocketAI pairing code. On your Mac, open Devices ▸ Pair iPhone and scan the code shown there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a PocketAI pairing code. On your Mac, open Devices ▸ Pair iPhone and scan the code shown there."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह PocketAI पेयरिंग कोड नहीं है। अपने Mac पर Devices ▸ Pair iPhone खोलें और वहाँ दिखा कोड स्कैन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ese no es un código de vinculación de PocketAI. En tu Mac, abre Dispositivos ▸ Vincular iPhone y escanea el código que aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce n’est pas un code d’association PocketAI. Sur votre Mac, ouvrez Appareils ▸ Associer un iPhone et scannez le code affiché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist kein PocketAI-Kopplungscode. Öffne auf deinem Mac Geräte ▸ iPhone koppeln und scanne den dort angezeigten Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これはPocketAIのペアリングコードではありません。Macで「デバイス ▸ iPhoneをペアリング」を開き、表示されたコードをスキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不是 PocketAI 配对码。请在 Mac 上打开“设备 ▸ 配对 iPhone”，然后扫描显示的代码。"
          }
        },
