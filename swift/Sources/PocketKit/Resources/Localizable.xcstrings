    "Your Mac isn't set up to run code from this iPhone. Turn on 'Let my paired iPhone run code' in PocketAI on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac isn't set up to run code from this iPhone. Turn on 'Let my paired iPhone run code' in PocketAI on your Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका Mac इस iPhone से कोड चलाने के लिए सेट नहीं है। अपने Mac पर PocketAI में ‘Let my paired iPhone run code’ चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac no está configurado para ejecutar código desde este iPhone. Activa «Let my paired iPhone run code» en PocketAI en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac n’est pas configuré pour exécuter du code depuis cet iPhone. Activez « Let my paired iPhone run code » dans PocketAI sur votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac ist nicht dafür eingerichtet, Code von diesem iPhone auszuführen. Schalte in PocketAI auf deinem Mac „Let my paired iPhone run code“ ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacはこのiPhoneからのコード実行を許可していません。MacのPocketAIで「Let my paired iPhone run code」をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 尚未设置为运行来自此 iPhone 的代码。请在 Mac 上的 PocketAI 中开启“Let my paired iPhone run code”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu Mac não está configurado para executar código deste iPhone. Ative “Let my paired iPhone run code” no PocketAI no seu Mac."
          }
        }
      }
    },
    "Your Mac isn't showing a pairing code right now, or it was already used. On your Mac, open Devices › Pair a device… › Enter code manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac isn't showing a pairing code right now, or it was already used. On your Mac, open Devices › Pair a device… › Enter code manually."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका Mac अभी पेयरिंग कोड नहीं दिखा रहा है, या वह पहले ही इस्तेमाल हो चुका है। अपने Mac पर Devices › Pair a device… › Enter code manually खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac no muestra ahora ningún código de vinculación, o ya se usó. En tu Mac, abre Dispositivos › Vincular un dispositivo… › Introducir código manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac n’affiche pas de code d’association pour le moment, ou il a déjà été utilisé. Sur votre Mac, ouvrez Appareils › Associer un appareil… › Saisir le code manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac zeigt gerade keinen Kopplungscode an, oder er wurde bereits verwendet. Öffne auf deinem Mac Geräte › Gerät koppeln … › Code manuell eingeben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macにペアリングコードが表示されていないか、すでに使用済みです。Macで「デバイス › デバイスをペアリング… › コードを手動で入力」を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 当前没有显示配对码，或该配对码已被使用。请在 Mac 上打开“设备 › 配对设备… › 手动输入代码”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu Mac não está mostrando um código de pareamento agora, ou ele já foi usado. No Mac, abra Dispositivos › Parear um dispositivo… › Inserir código manualmente."
          }
        }
      }
    },
    "Your Mac sent an unexpected reply. Update PocketAI on both devices and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac sent an unexpected reply. Update PocketAI on both devices and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके Mac ने अप्रत्याशित जवाब भेजा। दोनों डिवाइस पर PocketAI अपडेट करें और फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac envió una respuesta inesperada. Actualiza PocketAI en ambos dispositivos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac a envoyé une réponse inattendue. Mettez à jour PocketAI sur les deux appareils et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac hat eine unerwartete Antwort gesendet. Aktualisiere PocketAI auf beiden Geräten und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macから予期しない応答が返されました。両方のデバイスでPocketAIをアップデートして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
