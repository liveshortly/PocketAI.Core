          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बहुत ज़्यादा गलत कोड डाले गए, इसलिए वह कोड अब काम नहीं करता। अपने Mac पर ‘New code’ क्लिक करें और नया कोड डालें।"
          }
        },
        "es": {
          "stringUnit": {
