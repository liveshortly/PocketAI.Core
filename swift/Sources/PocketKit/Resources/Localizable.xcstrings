{
  "sourceLanguage": "en",
  "strings": {
    "A pairing code is 8 letters and numbers, like K7QM-2XPA. Check the code under Enter code manually on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pairing code is 8 letters and numbers, like K7QM-2XPA. Check the code under Enter code manually on your Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग कोड 8 अक्षरों और अंकों का होता है, जैसे K7QM-2XPA। अपने Mac पर ‘Enter code manually’ के तहत कोड देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un código de vinculación tiene 8 letras y números, como K7QM-2XPA. Revisa el código en «Introducir código manualmente» en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un code d’association comporte 8 lettres et chiffres, comme K7QM-2XPA. Vérifiez le code sous « Saisir le code manuellement » sur votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Kopplungscode besteht aus 8 Buchstaben und Ziffern, z. B. K7QM-2XPA. Prüfe den Code unter „Code manuell eingeben“ auf deinem Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングコードは K7QM-2XPA のような8桁の英数字です。Macの「コードを手動で入力」の下にあるコードを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配对码由 8 个字母和数字组成，例如 K7QM-2XPA。请在 Mac 上的“手动输入代码”下查看代码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um código de pareamento tem 8 letras e números, como K7QM-2XPA. Confira o código em “Inserir código manualmente” no seu Mac."
          }
        }
      }
    },
    "Another run is in progress.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another run is in progress."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक और रन चल रहा है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay otra ejecución en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une autre exécution est en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es läuft bereits ein anderer Lauf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別の実行が進行中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "另一个运行正在进行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Há outra execução em andamento."
          }
        }
      }
    },
    "Chat sync is off for this iPhone on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat sync is off for this iPhone on your Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके Mac पर इस iPhone के लिए चैट सिंक बंद है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sincronización de chats está desactivada para este iPhone en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La synchronisation des discussions est désactivée pour cet iPhone sur votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Chat-Synchronisierung ist für dieses iPhone auf deinem Mac ausgeschaltet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このiPhoneのチャット同期は、Mac側でオフになっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你的 Mac 上，此 iPhone 的对话同步已关闭。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sincronização de conversas está desativada para este iPhone no seu Mac."
          }
        }
      }
    },
    "Chat sync isn't available with this Mac yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat sync isn't available with this Mac yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस Mac के साथ चैट सिंक अभी उपलब्ध नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sincronización de chats aún no está disponible con este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La synchronisation des discussions n’est pas encore disponible avec ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Chat-Synchronisierung ist mit diesem Mac noch nicht verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacではチャットの同期はまだ利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Mac 暂不支持对话同步。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sincronização de conversas ainda não está disponível com este Mac."
          }
        }
      }
    },
    "Couldn't check this Mac's identity. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check this Mac's identity. Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस Mac की पहचान जाँची नहीं जा सकी। फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo comprobar la identidad de este Mac. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de vérifier l’identité de ce Mac. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Identität dieses Macs konnte nicht geprüft werden. Versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacの身元を確認できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法验证此 Mac 的身份。请重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível verificar a identidade deste Mac. Tente novamente."
          }
        }
      }
    },
    "Couldn't reach your Mac at %@ (port %lld). Check both are on the same Wi-Fi and PocketAI is open on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach your Mac at %@ (port %lld). Check both are on the same Wi-Fi and PocketAI is open on the Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (पोर्ट %lld) पर आपके Mac तक नहीं पहुँच सके। जाँचें कि दोनों एक ही Wi-Fi पर हैं और Mac पर PocketAI खुला है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo alcanzar tu Mac en %@ (puerto %lld). Comprueba que ambos estén en la misma red Wi-Fi y que PocketAI esté abierto en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre votre Mac à %@ (port %lld). Vérifiez que les deux sont sur le même Wi-Fi et que PocketAI est ouvert sur le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac war unter %@ (Port %lld) nicht erreichbar. Prüfe, ob beide im selben WLAN sind und PocketAI auf dem Mac geöffnet ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@（ポート%lld）のMacに接続できませんでした。両方が同じWi-Fiに接続されていて、MacでPocketAIが開いているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法通过 %@（端口 %lld）连接到你的 Mac。请确认两台设备在同一 Wi-Fi 下，且 Mac 上已打开 PocketAI。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível alcançar o seu Mac em %@ (porta %lld). Verifique se os dois estão no mesmo Wi-Fi e se o PocketAI está aberto no Mac."
          }
        }
      }
    },
    "JavaScript in a sandbox with no network or files. You approve every run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript in a sandbox with no network or files. You approve every run."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नेटवर्क या फ़ाइलों के बिना सैंडबॉक्स में JavaScript। हर बार चलाने से पहले आप मंज़ूरी देते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "JavaScript en un entorno aislado sin red ni archivos. Tú apruebas cada ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "JavaScript dans un bac à sable sans réseau ni fichiers. Vous approuvez chaque exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "JavaScript in einer Sandbox ohne Netzwerk und Dateien. Du genehmigst jeden Lauf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワークもファイルもないサンドボックスでJavaScriptを実行します。実行のたびに承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在无网络、无文件的沙盒中运行 JavaScript。每次运行都需你批准。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "JavaScript em uma sandbox sem rede nem arquivos. Você aprova cada execução."
          }
        }
      }
    },
    "Lost the connection to your Mac while pairing (%@). Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost the connection to your Mac while pairing (%@). Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग के दौरान आपके Mac से कनेक्शन टूट गया (%@)। फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se perdió la conexión con tu Mac durante la vinculación (%@). Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connexion perdue avec votre Mac pendant l’association (%@). Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung zu deinem Mac ging beim Koppeln verloren (%@). Versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリング中にMacとの接続が切れました（%@）。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配对期间与你的 Mac 断开了连接（%@）。请重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com o seu Mac foi perdida durante o pareamento (%@). Tente novamente."
          }
        }
      }
    },
    "Mac disconnected · Connect it from the Mac tab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac disconnected · Connect it from the Mac tab."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac डिस्कनेक्ट है · Mac टैब से इसे कनेक्ट करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac desconectado · Conéctalo desde la pestaña Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac déconnecté · Reconnectez-le depuis l’onglet Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac getrennt · Verbinde ihn im Tab „Mac“ wieder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macの接続が解除されています · 「Mac」タブから接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 已断开 · 请在“Mac”标签页中重新连接。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac desconectado · Conecte-o pela aba Mac."
          }
        }
      }
    },
    "No answer from your Mac. Click Allow on the Mac when it asks, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from your Mac. Click Allow on the Mac when it asks, then try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके Mac से कोई जवाब नहीं मिला। Mac पूछे तो Allow क्लिक करें, फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac no respondió. Haz clic en Permitir en el Mac cuando te lo pida y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas de réponse de votre Mac. Cliquez sur Autoriser sur le Mac quand il le demande, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Antwort von deinem Mac. Klicke auf dem Mac auf „Erlauben“, wenn er fragt, und versuche es dann erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macから応答がありません。Macで確認が表示されたら「許可」をクリックしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 没有响应。当 Mac 询问时请点按“允许”，然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma resposta do seu Mac. Clique em Permitir no Mac quando ele perguntar e tente novamente."
          }
        }
      }
    },
    "PocketAI can't see your local network. Turn on Settings ▸ Privacy & Security ▸ Local Network ▸ PocketAI, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI can't see your local network. Turn on Settings ▸ Privacy & Security ▸ Local Network ▸ PocketAI, then try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI आपका लोकल नेटवर्क नहीं देख पा रहा है। सेटिंग्स ▸ गोपनीयता और सुरक्षा ▸ लोकल नेटवर्क ▸ PocketAI चालू करें, फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI no puede ver tu red local. Activa Ajustes ▸ Privacidad y seguridad ▸ Red local ▸ PocketAI y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI ne peut pas accéder à votre réseau local. Activez Réglages ▸ Confidentialité et sécurité ▸ Réseau local ▸ PocketAI, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI kann dein lokales Netzwerk nicht sehen. Schalte Einstellungen ▸ Datenschutz & Sicherheit ▸ Lokales Netzwerk ▸ PocketAI ein und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIがローカルネットワークにアクセスできません。「設定 ▸ プライバシーとセキュリティ ▸ ローカルネットワーク ▸ PocketAI」をオンにして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 无法访问你的本地网络。请开启“设置 ▸ 隐私与安全性 ▸ 本地网络 ▸ PocketAI”，然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI não consegue ver sua rede local. Ative Ajustes ▸ Privacidade e Segurança ▸ Rede Local ▸ PocketAI e tente novamente."
          }
        }
      }
    },
    "Python in a sandbox with no network or files. You approve every run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python in a sandbox with no network or files. You approve every run."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नेटवर्क या फ़ाइलों के बिना सैंडबॉक्स में Python। हर बार चलाने से पहले आप मंज़ूरी देते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python en un entorno aislado sin red ni archivos. Tú apruebas cada ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python dans un bac à sable sans réseau ni fichiers. Vous approuvez chaque exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python in einer Sandbox ohne Netzwerk und Dateien. Du genehmigst jeden Lauf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワークもファイルもないサンドボックスでPythonを実行します。実行のたびに承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在无网络、无文件的沙盒中运行 Python。每次运行都需你批准。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python em uma sandbox sem rede nem arquivos. Você aprova cada execução."
          }
        }
      }
    },
    "Python, JavaScript or shell on your paired Mac, in a sandbox with no network and no access to your files. You approve every run, and your Mac must allow it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, JavaScript or shell on your paired Mac, in a sandbox with no network and no access to your files. You approve every run, and your Mac must allow it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके जोड़े गए Mac पर Python, JavaScript या शेल, बिना नेटवर्क और आपकी फ़ाइलों तक पहुँच के सैंडबॉक्स में। हर बार चलाने से पहले आप मंज़ूरी देते हैं, और आपके Mac को भी इसकी अनुमति देनी होगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python, JavaScript o shell en tu Mac vinculado, en un entorno aislado sin red ni acceso a tus archivos. Tú apruebas cada ejecución y tu Mac debe permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python, JavaScript ou shell sur votre Mac associé, dans un bac à sable sans réseau ni accès à vos fichiers. Vous approuvez chaque exécution, et votre Mac doit l’autoriser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python, JavaScript oder Shell auf deinem gekoppelten Mac, in einer Sandbox ohne Netzwerk und ohne Zugriff auf deine Dateien. Du genehmigst jeden Lauf, und dein Mac muss es erlauben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングしたMac上で、ネットワークもファイルへのアクセスもないサンドボックスでPython、JavaScript、またはシェルを実行します。実行のたびに承認が必要で、Mac側でも許可されている必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在已配对的 Mac 上，于无网络且无法访问你文件的沙盒中运行 Python、JavaScript 或 shell。每次运行都需你批准，且你的 Mac 必须允许。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Python, JavaScript ou shell no seu Mac pareado, em uma sandbox sem rede e sem acesso aos seus arquivos. Você aprova cada execução, e o seu Mac precisa permitir."
          }
        }
      }
    },
    "Reached your Mac, but its security certificate doesn't match the code. Close Pair iPhone on the Mac, open it again, and scan the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached your Mac, but its security certificate doesn't match the code. Close Pair iPhone on the Mac, open it again, and scan the new code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके Mac तक पहुँचे, लेकिन उसका सुरक्षा प्रमाणपत्र कोड से मेल नहीं खाता। Mac पर Pair iPhone बंद करें, उसे फिर खोलें और नया कोड स्कैन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se alcanzó tu Mac, pero su certificado de seguridad no coincide con el código. Cierra Vincular iPhone en el Mac, ábrelo de nuevo y escanea el código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac est joignable, mais son certificat de sécurité ne correspond pas au code. Fermez Associer un iPhone sur le Mac, rouvrez-le et scannez le nouveau code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac wurde erreicht, aber sein Sicherheitszertifikat passt nicht zum Code. Schließe „iPhone koppeln“ auf dem Mac, öffne es erneut und scanne den neuen Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macには接続できましたが、セキュリティ証明書がコードと一致しません。Macで「iPhoneをペアリング」を閉じて開き直し、新しいコードをスキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已连接到你的 Mac，但其安全证书与代码不匹配。请在 Mac 上关闭“配对 iPhone”，重新打开并扫描新代码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O seu Mac foi alcançado, mas o certificado de segurança não corresponde ao código. Feche Parear iPhone no Mac, abra de novo e escaneie o novo código."
          }
        }
      }
    },
