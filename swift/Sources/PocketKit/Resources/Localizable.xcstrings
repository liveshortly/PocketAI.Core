    "That code expired. Codes last 5 minutes — on your Mac, click New code and enter the new one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code expired. Codes last 5 minutes — on your Mac, click New code and enter the new one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह कोड समाप्त हो गया। कोड 5 मिनट चलते हैं — अपने Mac पर ‘New code’ क्लिक करें और नया कोड डालें।"
          }
        },
        "es": {
          "stringUnit": {
