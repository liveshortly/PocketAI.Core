    "%@ on %@, in a sandbox with no network and no access to your files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@, in a sandbox with no network and no access to your files."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, %@ पर, ऐसे सैंडबॉक्स में जिसमें नेटवर्क नहीं है और आपकी फ़ाइलों तक पहुँच नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ en %@, en un entorno aislado sin red ni acceso a tus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ sur %@, dans un bac à sable sans réseau et sans accès à vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ auf %@, in einer Sandbox ohne Netzwerk und ohne Zugriff auf deine Dateien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@を%@で実行します。ネットワークなし、ファイルへのアクセスなしのサンドボックス内です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@，在%@上运行，处于无网络、无法访问你文件的沙盒中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ em %@, em uma sandbox sem rede e sem acesso aos seus arquivos."
          }
        }
      }
    },
