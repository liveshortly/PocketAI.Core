    "It runs in a sandbox on this device with no network and no access to your files.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs in a sandbox on this device with no network and no access to your files."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह इस डिवाइस पर सैंडबॉक्स में चलता है, बिना नेटवर्क और आपकी फ़ाइलों तक पहुँच के।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ejecuta en un entorno aislado en este dispositivo, sin red y sin acceso a tus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il s’exécute dans un bac à sable sur cet appareil, sans réseau et sans accès à vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er läuft in einer Sandbox auf diesem Gerät ohne Netzwerk und ohne Zugriff auf Ihre Dateien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このデバイス上のサンドボックスで実行され、ネットワークにもファイルにもアクセスしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它在此设备的沙盒中运行，无法联网，也无法访问你的文件。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele roda em um sandbox neste dispositivo, sem rede e sem acesso aos seus arquivos."
          }
        }
      }
    },
