          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बोलकर लिखने के लिए दो बार टैप करें, या हैंड्स-फ़्री भेजने के लिए दो बार टैप करके दबाए रखें"
